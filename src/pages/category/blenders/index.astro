---
import Layout from '../../../layouts/Layout.astro';
import ProductPicks from '../../../components/ProductPicks.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import type { Product } from '../../../components/ProductPicks.astro';

const products: Product[] = [
  {
    name: 'Ninja 2-in-1 Blender & Smoothie Maker',
    badge: 'Best overall',
    blurb: 'A proper jug blender plus personal to-go cups in one. Enough power to crush ice and frozen fruit without labouring, and every part is dishwasher-safe.',
    pros: ['Jug + to-go cups', 'Crushes ice easily', 'All parts dishwasher-safe'],
    query: 'Ninja 2-in-1 blender smoothie maker',
  },
  {
    name: 'NutriBullet 600',
    badge: 'Best for smoothies',
    blurb: 'The reliable personal blender. Load a cup, twist, blend, and drink from the same cup — ideal for one-a-day smoothies and quick protein shakes.',
    pros: ['Compact & quick', 'Blend-in-the-cup', 'Very easy to clean'],
    query: 'NutriBullet 600 blender',
  },
  {
    name: 'Salter Active Blender',
    badge: 'Best value',
    blurb: 'The easiest way in. A single-serve bottle blender that does smoothies and shakes on a budget, with a lid you can screw on and take with you.',
    pros: ['Best value pick', 'Sports-bottle lid', 'Light & portable'],
    query: 'Salter active blender bottle',
  },
];
---

<Layout title="Best Budget Blenders (UK)" description="The best budget blenders for smoothies, soups and shakes — personal and jug picks that handle ice without the premium price." image="/share/blenders.png" imageWide="/share/blenders-wide.png">
  <section class="pad">
    <div class="wrap prose">
      <img class="share-pin" src="/share/blenders.png" width="1000" height="1500" alt="Best budget blenders — Bright Picks Kitchen Gadgets" loading="lazy" />
      <p class="breadcrumb"><a href="/">Home</a> · Blenders</p>
      <h1>Best budget blenders</h1>
      <p class="lead">Whether it's a morning smoothie, a batch of soup or a post-gym shake, the right blender pays for itself fast. These three cover personal, jug and bargain options.</p>
      <ProductPicks products={products} />
      <p class="note">Prices and availability change often. Always double-check the current price and delivery options on Amazon before buying.</p>
      <CategoryNav slug="blenders" dealsQuery="blender" dealsLabel="blender" />
    </div>
  </section>
</Layout>
