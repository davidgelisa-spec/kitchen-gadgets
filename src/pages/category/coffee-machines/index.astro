---
import Layout from '../../../layouts/Layout.astro';
import ProductPicks from '../../../components/ProductPicks.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import type { Product } from '../../../components/ProductPicks.astro';

const products: Product[] = [
  {
    name: "De'Longhi Dedica EC685",
    badge: 'Best overall',
    blurb: 'A slim 15-bar espresso machine that punches well above its footprint. Only 15cm wide, so it fits where full machines can\'t, and it pulls a genuinely good shot.',
    pros: ['Just 15cm wide', 'Real 15-bar espresso', 'Steam wand for milk'],
    query: "De'Longhi Dedica EC685 espresso machine",
  },
  {
    name: 'Bosch Tassimo Vivy 2',
    badge: 'Easiest',
    blurb: 'Pod simplicity at its cheapest. Drop in a T-Disc, press once, and it reads the barcode to pour the right drink — from espresso to hot chocolate.',
    pros: ['One-touch pods', 'Fast to warm up', 'Tiny footprint'],
    query: 'Bosch Tassimo Vivy 2 coffee machine',
  },
  {
    name: 'Morphy Richards Filter Coffee Maker',
    badge: 'Best for a crowd',
    blurb: 'When you need a full jug rather than a single cup. A no-drama filter machine with a keep-warm plate — the best value per cup of the three.',
    pros: ['Brews a full carafe', 'Keep-warm plate', 'Great value per cup'],
    query: 'Morphy Richards filter coffee maker',
  },
];
---

<Layout title="Best Budget Coffee Machines (UK)" description="The best budget coffee machines for home — espresso, pod and filter picks that fit small kitchens and smaller budgets." image="/share/coffee-machines.png" imageWide="/share/coffee-machines-wide.png">
  <section class="pad">
    <div class="wrap prose">
      <img class="share-pin" src="/share/coffee-machines.png" width="1000" height="1500" alt="Best budget coffee machines — Bright Picks Kitchen Gadgets" loading="lazy" />
      <p class="breadcrumb"><a href="/">Home</a> · Coffee Machines</p>
      <h1>Best budget coffee machines</h1>
      <p class="lead">Great coffee at home doesn't need a £500 machine. Depending on whether you want espresso, one-touch pods or a full jug, one of these three is your answer.</p>
      <ProductPicks products={products} />
      <p class="note">Prices and availability change often. Always double-check the current price and delivery options on Amazon before buying.</p>
      <CategoryNav slug="coffee-machines" dealsQuery="coffee machine" dealsLabel="coffee machine" />
    </div>
  </section>
</Layout>
