---
import Layout from '../../../layouts/Layout.astro';
import ProductPicks from '../../../components/ProductPicks.astro';
import CategoryNav from '../../../components/CategoryNav.astro';
import type { Product } from '../../../components/ProductPicks.astro';

const products: Product[] = [
  {
    name: 'Joseph Joseph DrawerStore Cutlery Tray',
    badge: 'Best overall',
    rating: 4.8,
    blurb: 'A cleverly tiered tray that holds more cutlery in less drawer space, keeping forks and knives separated on two levels. The one everyone recommends for a reason.',
    pros: ['Two-tier — saves space', 'Non-slip base', 'Wipes clean'],
    query: 'Joseph Joseph DrawerStore cutlery tray',
  },
  {
    name: 'mDesign Stackable Fridge Storage Bins',
    badge: 'Best for the fridge',
    rating: 4.5,
    blurb: 'Clear, stackable bins that turn a chaotic fridge into something you can actually see into. Pull one out like a drawer instead of excavating the back shelf.',
    pros: ['See-through & stackable', 'Pull-out handles', 'Multipack value'],
    query: 'mDesign stackable fridge storage bins clear',
  },
  {
    name: 'SimpleHouseware Expandable Shelf',
    badge: 'Best for cupboards',
    rating: 4.4,
    blurb: 'Doubles the usable height of a cupboard shelf so tins and jars stop hiding behind each other. Expands to fit the gap you\'ve actually got.',
    pros: ['Expandable width', 'Doubles shelf space', 'Sturdy metal frame'],
    query: 'SimpleHouseware expandable cabinet shelf organizer',
  },
];
---

<Layout title="Best Kitchen Organisers (UK)" description="The best kitchen organisers for tidier drawers, cupboards and fridges — space-saving picks that actually earn their place.">
  <section class="pad">
    <div class="wrap prose">
      <p class="breadcrumb"><a href="/">Home</a> · Organisers</p>
      <h1>Best kitchen organisers</h1>
      <p class="lead">The cheapest way to make a small kitchen feel bigger is to use the space you already have properly. These three tidy up drawers, cupboards and the fridge.</p>
      <ProductPicks products={products} />
      <p class="note">Prices and availability change often. Always double-check the current price and delivery options on Amazon before buying.</p>
      <CategoryNav slug="organizers" dealsQuery="kitchen storage organiser" dealsLabel="organiser" />
    </div>
  </section>
</Layout>
