---
import { amazonSearch } from '../lib/affiliate';

export interface Product {
  name: string;
  badge?: string;
  blurb: string;
  pros: string[];
  query: string; // Amazon search query for the affiliate link
}
interface Props { products: Product[]; }
const { products } = Astro.props;

---

<ol class="picks">
  {products.map((p) => (
    <li class="pick">
      <div class="pick-head">
        <h3>{p.name}</h3>
        {p.badge && <span class="badge">{p.badge}</span>}
      </div>
      <div class="pick-basis">
        <span class="basis-label">Research-based pick</span>
        <a href="/about/#how-we-pick">how we choose</a>
      </div>
      <p class="blurb">{p.blurb}</p>
      <ul class="pros">
        {p.pros.map((pro) => <li>{pro}</li>)}
      </ul>
      <a class="btn" href={amazonSearch(p.query)} rel="sponsored nofollow noopener" target="_blank">Check price on Amazon</a>
    </li>
  ))}
</ol>
<p class="score-note" style="font-size:.85rem;opacity:.7;margin-top:10px;">We have not physically tested these products. Picks come from researching published specifications, customer feedback, warranty terms and professional reviews — the labels above are our recommendation, not a score from a rating system. <a href="/about/#how-we-pick">How we choose</a>.</p>
